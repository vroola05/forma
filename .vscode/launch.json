{
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-FormApplication<forma>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "org.commonground.forma.FormApplication",
            "projectName": "forma",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Launch Edge (Vite Frontend)",
            "url": "http://localhost:5173/system/admin",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${webRoot}/node_modules/*",
                "webpack:///src/*": "${webRoot}/src/*",
                "webpack:///*": "*",
                "asset:///*": "*",
                "vite://devices/browser/*": "${webRoot}/*"
            }
        }
    ]
}