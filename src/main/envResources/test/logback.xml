<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <variable scope="context" name="logPattern" value="%-5level DEV &quot;isp-projecten-be&quot; %logger{36} - %msg%n"/>
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <property name="log.folder" value="${catalina.base}/logs"/>
    
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %X{correlationId} ${logPattern}</pattern>
        </layout>
    </appender>
    
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.folder}/isp-projecten-be-dev-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %X{correlationId} ${logPattern}</pattern>
        </encoder>
    </appender>
    
    <appender name="SYSLOG" class="ch.qos.logback.classic.net.SyslogAppender">
        <syslogHost>10.128.42.106</syslogHost>
        <facility>USER</facility>
        <suffixPattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %X{correlationId} ${logPattern}</suffixPattern>
    </appender>
    
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="SYSLOG"/>
    </root>
</configuration>